    for i in range(2, n + 1):
        result *= i
    return result


def is_prime(n):
    \"\"\"
    Return True if n is a prime number, False otherwise.
    Handles n < 2 as non‑prime.
    \"\"\"
    if n < 2:
        return False
    if n == 2:
        return True
    if n % 2 == 0:
        return False
    i = 3
    while i * i <= n:
        if n % i == 0:
            return False
        i += 2
    return True


